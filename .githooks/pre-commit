#!/bin/sh
# Runs the gate (Tools/agentic-dev/check.sh) before every commit, whoever makes it: a person, Claude Code, or
# another agent. It checks the working tree, and is skipped when the checked files have not changed
# since the last pass. Enable once per clone:
#     git config core.hooksPath .githooks
# Skip for one commit with: git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
# The gate runs git itself; it must not inherit this commit's temporary index.
unset GIT_INDEX_FILE
exec "$root/Tools/agentic-dev/check.sh" --if-changed
